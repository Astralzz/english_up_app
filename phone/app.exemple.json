{
  "expo": {
    "name": "EnglishUp",
    "slug": "english_up_astralz_app",
    "version": "0.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/app/icons/icon.png",
    "scheme": "english-astralz-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app/icons/adaptive-icon.png",
        "backgroundColor": "#FFECB3"
      },
      "package": "com.astralz.english_up_astralz_app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app/icons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFECB3"
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "[PROJECT_ID]"
      }
    }
  }
}
